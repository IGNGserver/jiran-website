---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Name from './Name.astro';
import Questions from './Questions.astro';
import Rules from './Rules.astro';
import Flow from './Flow.astro';
import Privacy from './Privacy.astro';
import Sources from './Sources.astro';
import Install from './Install.astro';
import Footer from './Footer.astro';
import { getRelease } from '../data/release';
import type { Lang } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const release = await getRelease();
---
<Base lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} release={release} />
    <div class="content">
      <Name lang={lang} />
      <Questions lang={lang} />
      <Rules lang={lang} />
      <Flow lang={lang} />
      <Privacy lang={lang} />
      <Sources lang={lang} />
      <Install lang={lang} release={release} />
    </div>
  </main>
  <Footer lang={lang} />
  <script type="application/json" id="release-data" set:html={JSON.stringify(release)} />
</Base>

<style>
  .content {
    position: relative;
    background: var(--bg);
  }
</style>

<script>
  import { initRelease } from '../scripts/release';
  import { REPO } from '../data/product';
  initRelease(REPO);

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }
    },
    { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>

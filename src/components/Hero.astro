---
import { getImage } from 'astro:assets';
import wide from '../assets/renders/instrument-wide.webp';
import tall from '../assets/renders/instrument-tall.webp';
import { CONTENT, type Lang } from '../i18n/content';
import { REPO_URL, TOOLS } from '../data/product';
import type { ReleaseInfo } from '../data/release';
import DownloadLabel from './DownloadLabel.astro';

interface Props { lang: Lang; release: ReleaseInfo | null }
const { lang, release } = Astro.props;
const t = CONTENT[lang].hero;

const wideSet = await Promise.all([960, 1600, 2400].map((w) => getImage({ src: wide, width: w, format: 'webp', quality: 80 })));
const tallSet = await Promise.all([600, 900, 1200].map((w) => getImage({ src: tall, width: w, format: 'webp', quality: 80 })));
const srcset = (set: typeof wideSet) => set.map((i) => `${i.src} ${i.attributes.width}w`).join(', ');
const tools = TOOLS.map((x) => ({ n: x.name, c: [x.u, x.l, x.s] }));
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__stage" aria-hidden="true">
    <picture class="hero__poster">
      <source media="(max-aspect-ratio: 21/20)" srcset={srcset(tallSet)} sizes="100vw" />
      <img src={wideSet[1].src} srcset={srcset(wideSet)} sizes="100vw" alt="" width="2400" height="1260" fetchpriority="high" decoding="async" />
    </picture>
    <canvas class="hero__canvas" data-hero-canvas></canvas>
    <div class="hero__veil"></div>
  </div>

  <div class="wrap hero__content">
    <p class="hero__eyebrow mono">{t.eyebrow}</p>
    <h1 class="hero__title" id="hero-title">{t.title}</h1>
    <p class="hero__lead">{t.lead}</p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href="#install" data-dl-primary>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v9m0 0L4.5 7.5M8 11l3.5-3.5M3 14h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span>{t.ctaPrimary}</span>
        <DownloadLabel release={release} />
      </a>
      <a class="btn" href="#install">{t.ctaAll}</a>
      <a class="btn hero__src" href={REPO_URL} rel="noopener">{t.ctaSource} ↗</a>
    </div>
    <dl class="hero__stats">
      {t.stats.map((s) => (
        <div>
          <dt class="sr-only">{s.k}</dt>
          <dd><span class="hero__stat-n mono">{s.n}</span><span class="hero__stat-k">{s.k}</span></dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="hero__hud" aria-hidden="true">
    <div class="hero__counter" data-counter hidden>
      <span class="note">{t.counterLabel}</span>
      <span class="hero__counter-n mono" data-counter-n>~0</span>
      <span class="note">{t.counterUnit} · {t.counterNote}</span>
    </div>
    <div class="hero__focus" data-focus hidden>
      <span class="hero__focus-dot"></span>
      <span class="hero__focus-line"></span>
      <span class="hero__focus-text mono"><span class="hero__focus-k" data-focus-k></span><span data-focus-name></span><span class="hero__focus-caps" data-focus-caps></span></span>
    </div>
  </div>

  <a class="hero__cue mono" href="#name">{t.scroll}<span></span></a>
  <script type="application/json" data-hero-tools set:html={JSON.stringify(tools)} />
</section>

<style>
  .hero {
    position: relative;
    min-height: max(640px, 100svh);
    display: flex;
    align-items: center;
    isolation: isolate;
  }
  .hero__stage {
    position: fixed;
    inset: 0;
    z-index: -1;
    height: 100lvh;
    background: var(--ink);
  }
  .hero__poster img,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__poster img {
    object-fit: cover;
    object-position: 70% 50%;
  }
  .hero__canvas {
    opacity: 0;
    transition: opacity 1.4s var(--ease-out);
  }
  .hero.is-live .hero__canvas {
    opacity: 1;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(9 9 10 / 0.86) 0%, rgb(9 9 10 / 0.55) 34%, rgb(9 9 10 / 0) 60%),
      linear-gradient(0deg, var(--ink) 0%, rgb(9 9 10 / 0) 22%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    padding-top: calc(var(--nav-h) + 40px);
    padding-bottom: 120px;
  }
  .hero__eyebrow {
    font-size: var(--t-micro);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--bone-dim);
    margin-bottom: 18px;
  }
  .hero__title {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: var(--t-hero);
    line-height: 0.86;
    letter-spacing: -0.03em;
    margin-left: -0.04em;
  }
  :lang(zh) .hero__title {
    font-weight: 600;
    letter-spacing: 0.04em;
    line-height: 1;
  }
  .hero__lead {
    margin-top: clamp(22px, 3vw, 34px);
    max-width: 30em;
    font-size: var(--t-lead);
    line-height: 1.62;
    color: rgb(236 230 218 / 0.86);
    text-wrap: pretty;
  }
  :lang(zh) .hero__lead {
    word-break: keep-all;
    max-width: 31em;
  }
  :lang(en) .hero__lead {
    max-width: 28em;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 36px;
    margin: 56px 0 0;
  }
  .hero__stats dd {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .hero__stat-n {
    font-size: 1.5rem;
    color: var(--bone);
  }
  .hero__stats div:last-child .hero__stat-n {
    color: var(--cinnabar);
  }
  .hero__stat-k {
    font-size: var(--t-small);
    color: var(--bone-dim);
  }

  .hero__hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__counter {
    text-shadow: 0 0 14px var(--ink), 0 0 4px var(--ink);
    position: absolute;
    right: var(--gutter);
    bottom: 48px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    text-align: right;
  }
  .hero__counter-n {
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    letter-spacing: -0.02em;
    color: var(--bone);
  }
  .hero__focus {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 0;
    will-change: transform;
    transition: opacity 0.4s;
  }
  .hero__focus-dot {
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border: 1px solid var(--bone);
    border-radius: 50%;
  }
  .hero__focus-line {
    width: 40px;
    height: 1px;
    background: var(--line-2);
  }
  .hero__focus-text {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
    padding: 4px 9px;
    font-size: 0.75rem;
    color: var(--bone);
    background: rgb(9 9 10 / 0.6);
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .hero__focus-k {
    color: var(--bone-faint);
  }
  .hero__focus-caps {
    color: var(--cinnabar);
    letter-spacing: 0.1em;
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bone-faint);
    text-decoration: none;
  }
  .hero__cue span {
    width: 1px;
    height: 36px;
    background: linear-gradient(var(--bone-faint), transparent);
    animation: cue 2.4s var(--ease-io) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% { transform: scaleY(0); }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  @media (max-aspect-ratio: 21/20) {
    .hero {
      align-items: flex-end;
    }
    .hero__poster img {
      object-position: 50% 60%;
    }
    .hero__veil {
      background:
        linear-gradient(0deg, rgb(9 9 10 / 0.95) 0%, rgb(9 9 10 / 0.7) 42%, rgb(9 9 10 / 0) 70%),
        linear-gradient(180deg, rgb(9 9 10 / 0.6) 0%, rgb(9 9 10 / 0) 18%);
    }
    .hero__content {
      padding-top: max(calc(var(--nav-h) + 40px), 46svh);
      padding-bottom: 48px;
    }
    .hero__counter {
      top: calc(var(--nav-h) + 12px);
      bottom: auto;
    }
    .hero__cue {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .hero__counter {
      display: none;
    }
    .hero__src {
      display: none;
    }
    .hero__stats {
      gap: 8px 22px;
      margin-top: 40px;
    }
    .hero__stat-n {
      font-size: 1.2rem;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
  const stage = hero.querySelector<HTMLElement>('.hero__stage')!;
  const counter = hero.querySelector<HTMLElement>('[data-counter]')!;
  const counterN = hero.querySelector<HTMLElement>('[data-counter-n]')!;
  const focus = hero.querySelector<HTMLElement>('[data-focus]')!;
  const focusK = hero.querySelector<HTMLElement>('[data-focus-k]')!;
  const focusName = hero.querySelector<HTMLElement>('[data-focus-name]')!;
  const focusCaps = hero.querySelector<HTMLElement>('[data-focus-caps]')!;
  const tools: { n: string; c: boolean[] }[] = JSON.parse(hero.querySelector('[data-hero-tools]')!.textContent || '[]');

  // 首屏之后整个舞台淡出，内容区盖在上面
  const fade = () => {
    const p = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.9)));
    stage.style.opacity = String(1 - Math.max(0, (p - 0.45) / 0.55));
    stage.style.visibility = p >= 1 ? 'hidden' : 'visible';
  };
  window.addEventListener('scroll', fade, { passive: true });
  fade();

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gl = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  })();

  if (!reduced && gl) {
    const fmt = new Intl.NumberFormat('en-US');
    let lastText = '';
    const boot = () =>
      import('../scripts/hero/scene').then(({ startHero }) => {
        startHero({
          canvas,
          host: stage,
          tools: tools.map((x) => x.n),
          onReady: () => {
            hero.classList.add('is-live');
            counter.hidden = false;
            focus.hidden = false;
          },
          onCount: (n) => {
            const text = '~' + fmt.format(Math.floor(n));
            if (text !== lastText) counterN.textContent = lastText = text;
          },
          onFocus: ({ index, x, y, visible }) => {
            focus.style.opacity = visible ? '1' : '0';
            if (!visible) return;
            focus.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
            const tool = tools[index];
            if (tool && focusName.textContent !== tool.n) {
              focusK.textContent = String(index + 1).padStart(2, '0');
              focusName.textContent = tool.n;
              focusCaps.textContent = tool.c.map((on) => (on ? '●' : '○')).join('');
            }
          },
        });
      }).catch((err) => console.warn('[hero] WebGL scene unavailable, keeping the still', err));
    // 让首帧文字与静帧先上屏，再加载 three
    if ('requestIdleCallback' in window) (window as Window).requestIdleCallback(boot, { timeout: 1200 });
    else setTimeout(boot, 300);
  }
</script>
